# ==============================================================================
# DockPilot Alertmanager Email Notification Configuration (.env.example)
#
# Copy this file to .env and configure with your real SMTP provider credentials.
# NEVER commit .env to GitHub or source control. .env is ignored in .gitignore.
# ==============================================================================

# SMTP Smarthost / Server address (e.g. smtp.gmail.com, smtp.office365.com, or local relay)
SMTP_SMARTHOST=smtp.gmail.com

# SMTP Port (587 for STARTTLS, 465 for SSL/TLS, or 25 for unauthenticated local relay)
SMTP_PORT=587

# SMTP Authentication Username (typically your email address)
SMTP_AUTH_USERNAME=your-alerts-email@gmail.com

# SMTP Authentication Password (use a dedicated Gmail App Password or SMTP token)
SMTP_AUTH_PASSWORD=your-16-character-app-password

# Sender Email Address (From: address appearing in notification emails)
SMTP_FROM=your-alerts-email@gmail.com

# Default Alert Receiver Email (for unclassified or general alerts)
ALERT_RECEIVER_EMAIL=admin@dockpilot.local

# Critical Severity Alert Receiver Email (receives high-priority critical alerts)
ALERT_RECEIVER_CRITICAL_EMAIL=devops-critical@dockpilot.local

# Warning Severity Alert Receiver Email (receives warning-level alerts)
ALERT_RECEIVER_WARNING_EMAIL=devops-warning@dockpilot.local

# Require TLS for SMTP communication (true/false)
SMTP_REQUIRE_TLS=true
